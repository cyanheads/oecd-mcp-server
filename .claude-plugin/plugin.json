{
  "name": "oecd-mcp-server",
  "version": "0.1.4",
  "description": "Search and query 1,500+ OECD statistical datasets via SDMX. Keyless.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/oecd-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/oecd-mcp-server.git",
  "license": "Apache-2.0",
  "mcpServers": {
    "oecd-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/oecd-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
