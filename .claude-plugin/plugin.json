{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "oecd-mcp-server",
  "version": "0.4.0",
  "description": "Search and query 1,500+ OECD statistical datasets via SDMX. Keyless.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/oecd-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/oecd-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "oecd", "sdmx", "statistics", "economics"],
  "mcpServers": {
    "oecd-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/oecd-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
