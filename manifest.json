{
  "manifest_version": "0.3",
  "name": "oecd-mcp-server",
  "version": "0.4.0",
  "description": "Search and query 1,500+ OECD statistical datasets via SDMX. Keyless.",
  "author": { "name": "cyanheads" },
  "homepage": "https://github.com/cyanheads/oecd-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/oecd-mcp-server"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "OECD_DATAFRAME_DROP_ENABLED": "${user_config.OECD_DATAFRAME_DROP_ENABLED}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "OECD_DATAFRAME_DROP_ENABLED": {
      "type": "boolean",
      "title": "Enable oecd_dataframe_drop",
      "description": "Let callers drop staged DataCanvas tables with oecd_dataframe_drop. Registered but disabled when off.",
      "required": false,
      "default": false
    }
  }
}
